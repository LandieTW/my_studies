# HPC-Flex package

## Introduction
This is the HPC-Flex Python package.
This package is maintained by Olivier Caro (olivier.caro@technipfmc.com).

## Prerequisites

This package has been tested on Python 3.6, 3.7, 3.8 and 3.9.

## Usage

## Code sample

### Run an Orcaflex simulation
```python
import time
import datetime
import tempfile
from hpcflex import Job

# Create a Job object
my_job = Job()

# Create the actual Job in HPC-Flex and save
my_job.create(name="Orcaflex compute job " + datetime.datetime.now().strftime("%H:%M"),
            application="Orcaflex", application_version="11.1", high_priority=False, linked_job_id=None)
print("Orcaflex job created")
my_job.save()

# Upload input files from the specified zip file
my_job.upload_file("input", "../data/OrcaflexFull.zip")
print("Orcaflex input files uploaded")

# Optionaly prepare the Job
my_job.prepare()
print("Orcaflex job prepared")

# Execute the Job
my_job.execute()
print("Orcaflex job submitted")

# Wait for the Job completion in HPC-Flex
while my_job.status != "completed":
    print("Job status = %s" % my_job.status, end="\r")
    time.sleep(60)
    my_job.refresh()
print("\nOrcaflex job complete")

# Download logfiles to temporary directory
my_tempdir = tempfile.gettempdir()
my_job.download_files("temp", my_tempdir, "*_Log.txt")
print("\nOrcaflex log files downloaded to " + my_tempdir)

my_job.delete()
print("\nOrcaflex job deleted")
```

### Run an Orcaflex simulation followed by a life Temporal fatigue calculation
```python
import time
import datetime
from hpcflex import Job

# Create a Job object
my_job = Job()

# Create the actual Job in HPC-Flex and save
my_job.create(name="Orcaflex compute job " + datetime.datetime.now().strftime("%H:%M"),
            application="Orcaflex", high_priority=False, linked_job_id=None)
print("Orcaflex job created")
my_job.save()

# Save Orcaflex job id for Life Temporal
orcaflex_job_id = my_job.id

# Upload input files from the specified zip file
my_job.upload_file("input", "../data/OrcaflexData.zip")
print("Orcaflex input files uploaded")

# Optionaly prepare the Job
my_job.prepare()
print("Orcaflex job prepared")

# Execute the Job
my_job.execute()
print("Orcaflex job submitted")

# Wait for the Job completion in HPC-Flex
while my_job.status != "completed":
    print("Job status = %s" % my_job.status, end="\r")
    time.sleep(60)
    my_job.refresh()

print("\nOrcaflex job complete")

job_name = "LifeT compute job " + \
    datetime.datetime.now().strftime("%H:%M")  # Optional
application = "LifeTemporal"  # Orcaflex by default
high_priority = False  # False by default
linked_job_id = orcaflex_job_id  # Required for Life Temporal

# Create a Job object
my_job = Job()

# Create the actual Job in HPC-Flex and save
my_job.create(name=job_name, application=application,
    high_priority=high_priority, linked_job_id=linked_job_id)
my_job.save()

# Upload input files from the specified zip file
my_job.upload_file("input", "../data/LifeTemporalData.zip")
print("Life Temporal input files uploaded")

# Optionaly prepare the Job
my_job.prepare()
print("Life Temporal job prepared")

# Execute the Job
my_job.execute()
print("Life Temporal job submitted")

# Wait for the Job completion in HPC-Flex
while my_job.status != "completed":
    print("Job status = %s" % my_job.status, end='\r')
    time.sleep(60)
    my_job.refresh()

print("\nLife Temporal job complete")
```
